# =============================================================
# EduIA — Variables de entorno requeridas
# =============================================================
# Copiar este archivo como:
#   - .streamlit/secrets.toml   (para la app Streamlit)
#   - o exportar como variables de entorno (para la API FastAPI)
#
# NUNCA subir el archivo real con claves al repositorio.
# =============================================================

# ─── Google Gemini AI ─────────────────────────────────────────
# Obtener gratis en: https://aistudio.google.com
# Requerida para: evaluación de código, generación de cursos, chat IA
GEMINI_API_KEY=tu_api_key_aqui

# Pool de API keys adicionales (Semana 5 — rotación automática por cuota)
# Keys de proyectos distintos en Google AI Studio = cuotas independientes
GEMINI_API_KEY_2=tu_api_key_alternativa_2
GEMINI_API_KEY_3=tu_api_key_alternativa_3

# ─── Modo de ejecución ────────────────────────────────────────
# Valores: true | false
DEBUG=false
DEVELOPMENT=false
TESTING=false

# ─── API FastAPI (opcional) ───────────────────────────────────
# Puerto donde corre la API (default: 8000)
# API_PORT=8000

# ─── Cómo configurar según el entorno ─────────────────────────
#
# Streamlit (app principal):
#   Crear .streamlit/secrets.toml con:
#     GEMINI_API_KEY = "tu_api_key_aqui"
#
# FastAPI (API REST):
#   Windows PowerShell:
#     $env:GEMINI_API_KEY="tu_api_key_aqui"
#   Linux / Mac:
#     export GEMINI_API_KEY=tu_api_key_aqui
#
# CI/CD (GitHub Actions):
#   Configurar en: Settings > Secrets > Actions > GEMINI_API_KEY
#   (Las pruebas unitarias NO requieren clave real)
# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Obtener gratis en: https://aistudio.google.com
GEMINI_API_KEY=tu_api_key_aqui

# ─── Base de datos PostgreSQL (producción - Supabase) ─────────────────────────
# Si no se define, la app usa SQLite local automáticamente.
# Obtener en Supabase: Settings → Database → Connection string → URI
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:tu_password@db.xxxx.supabase.co:5432/postgres

# ─── Modo de ejecución ────────────────────────────────────────────────────────
DEBUG=false
DEVELOPMENT=false
TESTING=false

# ─── Cómo configurar ──────────────────────────────────────────────────────────
#
# Streamlit (app principal):
#   Crear .streamlit/secrets.toml con:
#     GEMINI_API_KEY = "tu_api_key"
#     DATABASE_URL   = "postgresql://..."
#
# FastAPI (API REST):
#   Windows PowerShell:
#     $env:GEMINI_API_KEY="tu_api_key"
#     $env:DATABASE_URL="postgresql://..."
#   Linux / Mac:
#     export GEMINI_API_KEY=tu_api_key
#     export DATABASE_URL=postgresql://...
#
# CI/CD (GitHub Actions):
#   Settings → Secrets → Actions → agregar GEMINI_API_KEY y DATABASE_URL
